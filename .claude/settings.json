{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/roadmap.mjs\" || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/secret-scanner.py\" || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/secret-scanner.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node scripts/roadmap.mjs)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "mcp__supabase__apply_migration",
      "mcp__Supabase__apply_migration"
    ],
    "deny": [
      "Bash(supabase functions deploy:*)",
      "Bash(supabase db push:*)",
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "mcp__supabase__deploy_edge_function",
      "mcp__Supabase__deploy_edge_function"
    ]
  },
  "env": {
    "CLAUDE_CODE_IDLE_COMPACT_MIN_TOKENS": "100000"
  }
}
